id: wavephoenix-mini-receiver
package: ext-comp
description: Board support for the WavePhoenix Mini Receiver
category: External
quality: production

requires:
  - name: rf-bm-bg22c3

define:
  # Joybus configuration
  - name: JOYBUS_PORT
    value: gpioPortA
  - name: JOYBUS_PIN
    value: 2
  - name: JOYBUS_TIMER
    value: TIMER1
  - name: JOYBUS_USART
    value: USART0

  # Pair button configuration
  - name: HAS_PAIR_BTN
    value: 1
  - name: PAIR_BTN_PORT
    value: gpioPortB
  - name: PAIR_BTN_PIN
    value: 0

  # Status LED configuration
  - name: HAS_STATUS_LED
    value: 1
  - name: STATUS_LED_PORT
    value: gpioPortC
  - name: STATUS_LED_PIN
    value: 1
  - name: STATUS_LED_INVERT
    value: 0

  # Bootloader button configuration
  - name: SL_BTL_BUTTON_PORT
    value: gpioPortB
  - name: SL_BTL_BUTTON_PIN
    value: 0